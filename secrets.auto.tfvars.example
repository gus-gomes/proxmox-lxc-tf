# Copy to secrets.auto.tfvars and fill in real values.
# secrets.auto.tfvars is gitignored and loaded automatically by Terraform.
proxmox_endpoint  = "https://your-pve-host:8006"
proxmox_api_token = "user@realm!tokenid=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
ct_password       = "change-me"
ssh_public_key    = "ssh-ed25519 AAAA... you@host"
